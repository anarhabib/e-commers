generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  HEADLIGHT
  TAILLIGHT
  SIDE_MARKER
  STOP_LIGHT
  FOG_LIGHT
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  sku         String          @unique
  category    ProductCategory
  priceCents  Int
  imageUrl    String?
  stock       Int             @default(0)

  make        String?
  model       String?
  yearFrom    Int?
  yearTo      Int?

  color       String?
  side        String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}